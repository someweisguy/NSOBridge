{
  "python.testing.pytestArgs": ["backend"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,

  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.tabSize": 2
  },
  "spellright.language": ["en"],
  "spellright.documentTypes": [
    "markdown",
    "latex",
    "plaintext",
    "typescript",
    "postcss"
  ],
  "spellright.parserByClass": {
    "postcss": {
      "parser": "plain"
    }
  },
  "files.associations": {
    "*.spec": "python"
  },
  "eslint.format.enable": true,
  "eslint.options": {
    "overrideConfigFile": "./frontend/configs/eslint.config.js"
  }
}
