{
  "cSpell.words": [
    "cacheables",
    "Cristian",
    "pycache",
    "sessionmaker",
    "Timeable",
    "wftda"
  ],
  "cSpell.ignoreWords": ["nsobridge", "onedir", "softprops", "tabler"],
  "python.testing.pytestArgs": ["backend"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,

  "editor.tabSize": 4,
