{
  "json.schemaDownload.enable": true,

  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.associations": {
    "*.spec": "python"
  },

  "[javascript]": {
    "editor.tabSize": 2,
    "editor.rulers": [80]
  },
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "editor.rulers": [80]
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.rulers": [80]
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.rulers": [80]
  },

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4,
    "editor.rulers": [88]
  },
  "python.testing.pytestArgs": ["backend"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,

  "eslint.format.enable": true,
  "eslint.options": {
    "overrideConfigFile": "./frontend/configs/eslint.config.js"
  },
  "cSpell.customDictionaries": {
    "custom-dictionary-workspace": {
      "name": "custom-dictionary-workspace",
      "path": "${workspaceFolder:nso-bridge}/.cspell/custom-dictionary-workspace.txt",
      "addWords": true,
      "scope": "workspace"
    }
  },
  "cSpell.ignoreWords": [
    "MEIPASS",
    "codesign",
    "datas",
    "hiddenimports",
    "hooksconfig",
    "hookspath",
    "pathex",
    "selectinload",
    "venv"
  ]
}
