{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "No GUI",
      "type": "debugpy",
      "request": "launch",
      "program": "backend/src/main.py",
      "args": ["0.0.0.0", "-d", "-f data.db"],
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python",
      "env": {
        "SQLALCHEMY_DEBUG": "false"
      }
    },
    {
      "name": "With GUI",
      "type": "debugpy",
      "request": "launch",
      "program": "backend/src/with_gui.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python",
      "env": {
        "SQLALCHEMY_DEBUG": "false"
      }
    }
  ]
}
