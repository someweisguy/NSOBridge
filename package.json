{
  "name": "nso-bridge",
  "version": "0.1.0",
  "packageManager": "npm@11.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build no-minify": "tsc -b && vite build --minify false",
    "watch": "tsc -b && vite build --watch",
    "lint": "eslint .",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,md,toml}": [
      "npx prettier --write",
      "eslint --fix"
    ],
    "*.py": [
      "uvx ty check",
      "uvx ruff check --fix",
      "uvx ruff format ."
    ]
  },
  "dependencies": {
    "@fit-screen/react": "^1.0.2",
    "@mantine/core": "^8.3.9",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.3.9",
    "@tabler/icons-react": "^3.35.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.75.5",
    "dayjs": "^1.11.20",
    "react": "^19.1.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-onboarding": "^10.2.17",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/react-vite": "^10.2.17",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-storybook": "^10.2.17",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-toml": "^2.0.6",
    "storybook": "^10.2.17",
    "storybook-addon-mock-date": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1",
    "vite-plugin-virtual-mpa": "^1.12.1",
    "vitest": "^4.0.18"
  }
}
