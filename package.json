{
  "name": "nso-bridge",
  "version": "0.1.0",
  "packageManager": "npm@11.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build -c frontend/configs/vite.config.ts",
    "lint": "eslint -c frontend/configs/eslint.config.js .",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006 --config-dir frontend/.storybook",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --dir frontend/ -c frontend/configs/vite.config.ts --project=storybook"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,md,toml}": [
      "npx prettier --write",
      "eslint -c frontend/configs/eslint.config.js --fix"
    ],
    "*.py": [
      "uvx ty check",
      "uvx ruff check --fix",
      "uvx ruff format ."
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-toml"
    ]
  },
  "dependencies": {
    "@fit-screen/react": "^1.0.2",
    "@mantine/core": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "dayjs": "^1.11.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-queryparams": "^10.0.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.59.1",
    "postcss": "^8.5.9",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-toml": "^2.0.6",
    "storybook": "^10.4.0",
    "storybook-addon-deep-controls": "^0.10.0",
    "storybook-addon-mock-date": "^3.0.2",
    "storybook-dark-mode": "^5.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "@swc/core@1.15.40": true,
    "esbuild@0.27.7": true,
    "msw@2.14.6": true,
    "unrs-resolver@1.12.2": true
  }
}
